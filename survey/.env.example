# ---------------------------------------------------------------------------
# Kopiér denne fil til ".env" og udfyld den. .env må aldrig committes.
# ---------------------------------------------------------------------------

# Serveren
PORT=3000
# Sæt til "true" hvis siden kører bag en reverse proxy (nginx, Render, Fly.io …),
# så rate limit ser den rigtige IP-adresse.
# TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Mail. Uden SMTP_HOST kører siden i "console"-tilstand: alt virker, men
# mailen sendes ikke - den gemmes som .eml-fil i data/outbox/ så du kan se den.
# ---------------------------------------------------------------------------
# MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
# 587 = STARTTLS (sæt SMTP_SECURE=false), 465 = TLS fra start (SMTP_SECURE=true)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Afsender. MAIL_FROM skal være en adresse, din mailudbyder tillader dig at sende fra.
MAIL_FROM=ingen-svar@ditdomæne.dk
MAIL_FROM_NAME=Dit firmanavn
# Adresse som svar på kvitteringen lander på (valgfrit)
MAIL_REPLY_TO=
# Få selv en skjult kopi af hver kvittering - flere adresser adskilles med komma (valgfrit)
MAIL_COPY_TO=

# ---------------------------------------------------------------------------
# Eksport af besvarelser. Uden ADMIN_TOKEN er /admin-siderne slået helt fra.
# Lav en tilfældig nøgle med: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
ADMIN_TOKEN=

# Rate limit pr. IP-adresse
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
